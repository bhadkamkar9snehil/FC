<Window x:Class="FC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FC — LAN Folder Sync" Height="820" Width="1240" MinHeight="680" MinWidth="980"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Background="#17212A" Padding="26,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="7" Background="#2D8A77" Margin="0,0,12,0">
                            <TextBlock Text="FC" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Folder Connector" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DeviceSummaryText" Foreground="#AFC1C9" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="StartupCheck" Content="Start with Windows" Foreground="#DCE7EB" VerticalAlignment="Center" Margin="0,0,18,0" Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed"/>
                    <Button Content="Invite teammate" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Invite_Click"/>
                    <Button Content="Pair device" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Pair_Click"/>
                    <Button Content="Add folder" Style="{StaticResource PrimaryButton}" Click="AddFolder_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="26">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2.15*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,18,0">
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Shared folders" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="FolderSummaryText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="Sync now" Style="{StaticResource SecondaryButton}" Padding="12,7" Click="SyncNow_Click"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl x:Name="FoldersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                                <Border Background="#E6F2EF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Status}" Foreground="#176B5B" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding PeerText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding SafetyText}" Foreground="#A34B00" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Open" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,6,0" Tag="{Binding FolderId}" Click="OpenFolder_Click"/>
                                            <Button Content="Share" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,6,0" Tag="{Binding FolderId}" Click="ShareFolder_Click"/>
                                            <Button Content="{Binding ToggleText}" Style="{StaticResource SecondaryButton}" Padding="10,6" Tag="{Binding FolderId}" Click="ToggleFolder_Click"/>
                                        </StackPanel>
                                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FileCountText}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LastStateText}" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="EmptyFoldersPanel" Style="{StaticResource CardBorder}" Padding="28" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="No folders configured" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Add a local folder, then share it with a paired teammate." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,14"/>
                            <Button Content="Add your first folder" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="AddFolder_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Pending shares" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="PendingSharesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,9" BorderBrush="#D7B56D">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding FromText}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Accept" Style="{StaticResource PrimaryButton}" Padding="10,6" Margin="0,0,6,0" Tag="{Binding PendingId}" Click="AcceptShare_Click"/>
                                            <Button Content="Decline" Style="{StaticResource SecondaryButton}" Padding="10,6" Tag="{Binding PendingId}" Click="DeclineShare_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoPendingText" Text="No pending folder invitations." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,18"/>

                    <TextBlock Text="Devices" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="PeersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Endpoint}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding LastSeen}" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoPeersText" Text="No teammates paired yet." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,18"/>

                    <TextBlock Text="Recent activity" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource CardBorder}" Padding="8">
                        <ItemsControl x:Name="ActivityList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EDF0F2" BorderThickness="0,0,0,1" Padding="7,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Meta}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
